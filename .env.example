NAVER_MAP_NCP_KEY_ID=
EXPO_PUBLIC_NAVER_MAP_NCP_KEY_ID=
EXPO_PUBLIC_NAVER_MAP_WEB_NCP_KEY_ID=

# Mobile/web app API base. Expo exposes only EXPO_PUBLIC_* values to the app bundle.
# Local API server: http://localhost:8787
# Production web/APK: https://api.dairuri.harammm.me
# Do not point the mobile app at PostgreSQL or Redis.
EXPO_PUBLIC_DARORI_API_BASE_URL=http://localhost:8787

# Test/local-only escape hatch. Production should leave this unset.
EXPO_PUBLIC_DARORI_USE_MOCK_API=

# Development-only fallback for old scripts that still send X-Darori-User-Id.
# Production uses Authorization: Bearer <session token> from /auth/login or /auth/signup.
EXPO_PUBLIC_DARORI_ALLOW_DEV_USER_HEADER=
EXPO_PUBLIC_DARORI_USER_ID=
DARORI_ALLOW_DEV_USER_HEADER=

# Temporary web demo login. Only set this with a disposable auth session token.
EXPO_PUBLIC_DARORI_SKIP_AUTH=
EXPO_PUBLIC_DARORI_TEST_AUTH_TOKEN=

# Required for server-side NAVER Maps REST APIs such as Geocoding.
# Keep this server-side only; the app calls /maps/geocode through Darori API.
NAVER_MAP_API_KEY=

# Optional but recommended for detailed place-name search such as stations,
# cafes, stores, and bus stops. These are NAVER Developers Search API keys,
# not the NAVER Cloud Maps application keys.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Server-side only. Used by DB scripts and API handlers.
DATABASE_URL=postgresql://darori:darori@localhost:54320/darori
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
REDIS_URL=redis://localhost:63790
# Optional for SSH-tunneled rediss:// ElastiCache checks.
REDIS_TLS_SERVERNAME=
REDIS_TLS_REJECT_UNAUTHORIZED=
DARORI_RATE_LIMIT_DISABLED=
DARORI_REPORTER_LABEL_SALT=

# Server-side phone verification SMS delivery through SOLAPI.
# Production signup rejects phone-code requests unless these values are set.
# SOLAPI_FROM must be a registered sender number; keep keys server-side only.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=

# Phone verification code storage hash secret.
# Set PHONE_VERIFICATION_DEBUG_CODE_ENABLED=true only for temporary test builds
# that should return the verification code in the API response.
PHONE_VERIFICATION_HASH_SECRET=
PHONE_VERIFICATION_DEBUG_CODE_ENABLED=
