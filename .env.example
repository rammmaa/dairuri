NAVER_MAP_NCP_KEY_ID=

# Mobile app API base. Expo exposes only EXPO_PUBLIC_* values to the app bundle.
# Point this at the Darori API server; do not point the mobile app at PostgreSQL or Redis.
EXPO_PUBLIC_DARORI_API_BASE_URL=

# Required later for NAVER Maps REST APIs such as Directions, Geocoding,
# Reverse Geocoding, and Static Map. Keep this server-side only.
NAVER_MAP_API_KEY=

# Server-side only. Used by `npm run db:check` and future API server handlers.
DATABASE_URL=postgresql://darori:darori@localhost:54320/darori
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
REDIS_URL=redis://localhost:63790
