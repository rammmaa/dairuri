{
  "name": "dairuri",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx server/db/checkConnections.ts",
    "db:schema": "tsx server/db/applySchema.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:reset": "DATABASE_RESET_SCHEMA=true tsx server/db/applySchema.ts && tsx server/db/seed.ts",
    "api:start": "tsx server/api/server.ts"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@mj-studio/react-native-naver-map": "^2.8.0",
    "dotenv": "^17.4.2",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.14.0",
    "pg": "^8.20.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.1.0",
    "jest-expo": "^54.0.17",
    "react-test-renderer": "^19.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
